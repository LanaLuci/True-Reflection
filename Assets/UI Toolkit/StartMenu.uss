.button {
    width: 200px;
    height: 100px;
    align-self: center;
    align-items: center;
    -unity-text-align: upper-center;
}

.button:hover {
    width: 400px;
    height: 100px;
    align-self: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    color: rgba(0, 126, 255, 0.85);
    -unity-text-align: upper-left;
    border-left-color: rgb(0, 154, 255);
    border-left-width: 5px;
    border-top-color: rgba(0, 0, 0, 0);
    transition-property: width;
    transition-duration: 0.1s;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-bottom-left-radius: 5px;
}

.quitbutton {
    width: 200px;
    height: 100px;
    align-self: center;
    align-items: center;
    -unity-text-align: upper-center;
}

.quitbutton:hover {
    width: 400px;
    height: 100px;
    align-self: center;
    align-items: center;
    background-color: rgba(188, 0, 0, 0.51);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    color: rgb(255, 73, 61);
    -unity-text-align: upper-left;
    border-left-color: rgb(255, 22, 0);
    border-left-width: 5px;
    border-top-color: rgba(0, 0, 0, 0);
    transition-property: width;
    transition-duration: 0.1s;
}
